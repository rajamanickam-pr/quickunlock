[Desktop Entry]
Type=Application
Name=Sign-in Options
GenericName=PIN and Face Unlock
Comment=Unlock your computer with a PIN or your face
Exec=quickunlock-settings
Icon=io.github.quickunlock.QuickUnlock
Terminal=false
Categories=GTK;GNOME;Settings;Security;
Keywords=PIN;face;unlock;login;sign-in;hello;biometric;lock screen;password;
StartupNotify=true
