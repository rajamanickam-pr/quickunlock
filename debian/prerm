#!/bin/sh
set -e
# Always take our lines out of the PAM stack before the files disappear.
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    /usr/bin/quickunlock-pam-setup disable || true
fi
find /usr/lib/quickunlock -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
